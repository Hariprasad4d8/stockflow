generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              Int       @id @default(autoincrement())
  name            String
  defaultLowStock Int       @default(5)
  createdAt       DateTime  @default(now())
  users           User[]
  products        Product[]
}

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  passwordHash String
  orgId        Int
  org          Organization @relation(fields: [orgId], references: [id])
  createdAt    DateTime     @default(now())
}

model Product {
  id                Int          @id @default(autoincrement())
  orgId             Int
  org               Organization @relation(fields: [orgId], references: [id])
  name              String
  sku               String
  description       String?
  quantity          Int          @default(0)
  costPrice         Float?
  sellingPrice      Float?
  lowStockThreshold Int?
  lastUpdatedBy     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([orgId, sku])
}
